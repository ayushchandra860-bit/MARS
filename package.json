{
  "name": "mars-pro",
  "version": "3.0.1-rc.1",
  "description": "MARS PRO — transparent AI-assisted market analysis and manual fixed-time trading decision support",
  "author": "MARS PRO Team",
  "private": true,
  "main": "dist-electron/main/main.js",
  "scripts": {
    "dev": "vite",
    "dev:electron": "vite",
    "clean:build": "node scripts/clean-build.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:ipc": "node scripts/audit-ipc-contracts.mjs",
    "verify:build": "node scripts/verify-build.mjs",
    "build": "npm run clean:build && npm run typecheck && vite build && npm run verify:build",
    "start": "electron .",
    "package": "npm run test && npm run build && electron-builder --win --x64 --publish never"
  },
  "dependencies": {
    "sql.js": "^1.12.0",
    "tesseract.js": "^5.1.1",
    "uuid": "^11.1.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/sql.js": "^1.4.9",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.3.0",
    "electron-builder": "^25.1.8",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vite-plugin-electron": "^0.28.0",
    "vite-plugin-electron-renderer": "^0.14.6",
    "vitest": "^3.0.0"
  },
  "build": {
    "appId": "com.mars.pro",
    "productName": "MARS PRO V3",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "icon": "resources/assets/app.ico"
    },
    "extraResources": [
      {
        "from": "resources/assets",
        "to": "assets"
      }
    ],
    "nsis": {
      "installerIcon": "resources/assets/installer.ico",
      "uninstallerIcon": "resources/assets/installer.ico",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "MARS PRO V3"
    }
  }
}
