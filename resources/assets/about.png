<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 450" width="800" height="450">
  <defs>
    <linearGradient id="bgGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#0B0C10"/>
      <stop offset="50%" stop-color="#12141D"/>
      <stop offset="100%" stop-color="#07080B"/>
    </linearGradient>
    <linearGradient id="titleGrad" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#FF3B30"/>
      <stop offset="50%" stop-color="#FF9500"/>
      <stop offset="100%" stop-color="#00F2FE"/>
    </linearGradient>
  </defs>
  <rect width="800" height="450" fill="url(#bgGrad)"/>
  <g transform="translate(336, 80) scale(0.25)">
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512" width="512" height="512">
  <defs>
    <radialGradient id="marsSphere" cx="40%" cy="40%" r="60%">
      <stop offset="0%" stop-color="#FF7A70"/>
      <stop offset="50%" stop-color="#E63946"/>
      <stop offset="85%" stop-color="#991B1B"/>
      <stop offset="100%" stop-color="#450A0A"/>
    </radialGradient>
    <linearGradient id="circuitGlow" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#FF9500"/>
      <stop offset="100%" stop-color="#FF3B30"/>
    </linearGradient>
    <linearGradient id="trendLine" x1="0%" y1="100%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#00F2FE"/>
      <stop offset="100%" stop-color="#4FACFE"/>
    </linearGradient>
    <filter id="glow" x="-20%" y="-20%" width="140%" height="140%">
      <feGaussianBlur stdDeviation="6" result="blur"/>
      <feComposite in="SourceGraphic" in2="blur" operator="over"/>
    </filter>
  </defs>

  <rect width="512" height="512" rx="96" fill="#0D0E12"/>
  <circle cx="256" cy="256" r="210" fill="none" stroke="rgba(255, 59, 48, 0.25)" stroke-width="3" stroke-dasharray="12 8"/>
  <circle cx="256" cy="256" r="190" fill="none" stroke="rgba(255, 149, 0, 0.2)" stroke-width="2"/>

  <circle cx="256" cy="256" r="135" fill="url(#marsSphere)" filter="url(#glow)"/>

  <path d="M145 256 H205 M256 145 V205 M307 256 H367 M256 307 V367" stroke="url(#circuitGlow)" stroke-width="4" stroke-linecap="round"/>
  <path d="M178 178 L218 218 M334 178 L294 218 M178 334 L218 294 M334 334 L294 294" stroke="url(#circuitGlow)" stroke-width="3" stroke-linecap="round"/>

  <circle cx="205" cy="256" r="6" fill="#FF9500"/>
  <circle cx="256" cy="205" r="6" fill="#FF9500"/>
  <circle cx="307" cy="256" r="6" fill="#FF9500"/>
  <circle cx="256" cy="307" r="6" fill="#FF9500"/>

  <path d="M 130 325 Q 190 285, 240 295 T 320 215 T 390 155" fill="none" stroke="url(#trendLine)" stroke-width="7" stroke-linecap="round" filter="url(#glow)"/>
  <circle cx="390" cy="155" r="9" fill="#00F2FE" filter="url(#glow)"/>
</svg>
  </g>
  <text x="400" y="270" text-anchor="middle" font-family="'Orbitron', sans-serif" font-weight="800" font-size="32" fill="url(#titleGrad)" letter-spacing="4">MARS PRO V3</text>
  <text x="400" y="305" text-anchor="middle" font-family="'Inter', sans-serif" font-weight="500" font-size="14" fill="#8E8E93" letter-spacing="2">AI TRADING TERMINAL</text>
  <rect x="250" y="360" width="300" height="4" rx="2" fill="rgba(255,255,255,0.1)"/>
  <rect x="250" y="360" width="180" height="4" rx="2" fill="url(#titleGrad)"/>
  <text x="400" y="390" text-anchor="middle" font-family="'Inter', sans-serif" font-weight="400" font-size="12" fill="#64748B">Initializing AI Decision Core...</text>
</svg>